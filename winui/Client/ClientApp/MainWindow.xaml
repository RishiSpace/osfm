<Window
    x:Class="OSFM.ClientApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="OSFM Client">
    <StackPanel Padding="24" Spacing="12"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <TextBlock Text="OSFM Client" Style="{StaticResource TitleTextBlockStyle}"/>
        <InfoBar x:Name="StateBar" Title="Searching for server…" Severity="Informational" IsOpen="True"/>
        <TextBlock x:Name="DetailText" Text="UDP discovery on port 12345…" TextWrapping="Wrap"/>
        <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="Wrap" Height="260"/>
    </StackPanel>
</Window>
