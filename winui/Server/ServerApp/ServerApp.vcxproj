<?xml version="1.0" encoding="utf-8"?>
<!-- ServerApp: WinUI 3 (Windows App SDK) x64 unpackaged app. Links OsfmCore.lib.
     NuGet (restored in CI): Microsoft.WindowsAppSDK, Microsoft.Windows.CppWinRT. -->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{A1B2C3D4-2222-4000-8000-000000000002}</ProjectGuid>
    <!-- RootNamespace feeds the XAML compiler: it generates
         XamlMetaDataProvider.idl with the matching namespace block.
         Without it the generated file has an empty namespace and
         MIDL fails with MIDL2025 (expecting NamespaceTag).
         Must match the x:Class roots in App.xaml / MainWindow.xaml. -->
    <RootNamespace>OSFM.ServerApp</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.17763.0</WindowsTargetPlatformMinVersion>
    <ApplicationType>Windows Store</ApplicationType>
    <ApplicationTypeRevision>10.0</ApplicationTypeRevision>
    <UseWinUI>true</UseWinUI>
    <!-- WinUI 3 unpackaged desktop app (template-faithful). ApplicationType
         Windows Store + UseWinUI drive the XAML compiler (.g.h generation).
         WindowsPackageType None + AppxPackage/AppContainer false means an
         unpackaged EXE. Requires the UWP C++ toolset, so CI pins
         windows-2022 (windows-latest dropped it). -->
    <AppxPackage>false</AppxPackage>
    <AppContainerApplication>false</AppContainerApplication>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Platforms>x64</Platforms>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props"/>
  <PropertyGroup>
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <LanguageStandard>stdcpp20</LanguageStandard>
    <CppWinRTEnabled>true</CppWinRTEnabled>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <OutDir>$(SolutionDir)x64\$(Configuration)\$(ProjectName)\</OutDir>
    <IntDir>$(SolutionDir)x64\$(Configuration)\obj\$(ProjectName)\</IntDir>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props"/>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(ProjectDir)Generated Files;$(ProjectDir);$(SolutionDir)Common\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>_WIN32_WINNT=0x0A00;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <WarningLevel>Level3</WarningLevel>
      <!-- See OsfmCore.vcxproj: explicit standard flag wins over props default. -->
      <AdditionalOptions>%(AdditionalOptions) /std:c++20 /Zc:__cplusplus</AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>OsfmCore.lib;Ws2_32.lib;Netapi32.lib;Shell32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(SolutionDir)x64\$(Configuration)\;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <ManifestFile>$(ProjectDir)app.manifest</ManifestFile>
      <SubSystem>Windows</SubSystem>
    </Link>
    <Midl>
      <AdditionalIncludeDirectories>%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </Midl>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Common\OsfmCore.vcxproj">
      <Project>{A1B2C3D4-1111-4000-8000-000000000001}</Project>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="pch.h"/>
    <ClInclude Include="App.xaml.h"/>
    <ClInclude Include="MainWindow.xaml.h"/>
    <ClInclude Include="TcpServer.h"/>
    <ClCompile Include="pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="App.xaml.cpp"/>
    <ClCompile Include="MainWindow.xaml.cpp"/>
    <!-- Engine TUs use the OsfmCore include dir directly and skip the app PCH
         (they have no pch.h include; else C1010). -->
    <ClCompile Include="TcpServer.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <!-- Only page/window IDLs: there is NO App.idl. The XAML compiler fully
         defines AppT from the Application root in App.xaml; adding an
         App.idl makes MIDL emit a conflicting App projection and App_base
         never resolves (C2039). Matches the working sample tree. -->
    <Midl Include="MainWindow.idl"/>
    <Page Include="App.xaml"/>
    <Page Include="MainWindow.xaml"/>
    <Manifest Include="app.manifest"/>
    <AppxManifest Include="Package.appxmanifest"/>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets"/>
  <ItemGroup Label="NuGet Packages">
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240627000"/>
    <PackageReference Include="Microsoft.Windows.CppWinRT" Version="2.0.240405001"/>
  </ItemGroup>
</Project>
